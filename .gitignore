# OS / editor junk
.DS_Store
*.pem

# env files (opt-in per app if needed)
.env*

# build artifacts — also ignored per-app, this is the monorepo backstop
**/node_modules/
**/.next/
**/out/
**/build/
**/coverage/
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# Render/experiment outputs must never enter git (multi-GB frame dumps, videos)
apps/trailer-render/frames/
apps/trailer-render/node_modules/
*.mp4
apps/trailer-render/*.png
apps/trailer-render/frames-list.txt

# Demo-scan assets (scene-pruned/ + scene.voxel.*) SHIP WITH THE SITE DEPLOY
# again (Vercel static): the old stepinside-assets R2 worker lives in a
# Cloudflare account we have no access to and its upload was incomplete
# (missing shN files caused 30-60s of 404 retries on every load). Only the
# legacy blobs stay out of git. Future per-property scans use `?assets=`
# with their own bucket.
apps/website/public/viewer/scene/
apps/website/public/viewer/scene-pruned-light.sog
apps/website/public/viewer/scene-light.sog
apps/website/public/viewer/scene.sog

# Auto-experience pipeline build/test outputs
dist/
apps/website/public/garage/
.wrangler/
